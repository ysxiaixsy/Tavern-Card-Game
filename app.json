{
  "expo": {
    "name": "GWENT",
    "slug": "GWENT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16100b",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jp.gwent",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#16100b",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16100b"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b71ad7c3-8c92-42d9-b959-ba79660bb8c1"
      }
    },
    "owner": "jp_gaultier"
  }
}
